# ===== Bắt buộc =====
# Lấy từ @BotFather trên Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# Chủ bot (host): nhận yêu cầu dùng bot của người mới để Duyệt/Từ chối, nhận note từ Zalo,
# dùng được /users /approve /revoke /zalo. Chạy bot, nhắn /id để lấy số.
OWNER_CHAT_ID=

# Chat id luôn được dùng mà không cần duyệt, cách nhau bởi dấu phẩy (tuỳ chọn).
# Để trống cả OWNER_CHAT_ID lẫn ALLOWED_CHAT_IDS = ai cũng dùng được, không cần duyệt.
ALLOWED_CHAT_IDS=

# Chống spam cho người dùng không phải host
# MAX_PENDING_PER_CHAT=200
# MAX_NOTES_PER_MINUTE=20

# ===== Nhắc việc =====
# REPEAT_EVERY_MIN=15
# MAX_REPEATS=6
# Giờ gửi tóm tắt việc trong ngày, -1 để tắt
# DIGEST_HOUR=7
# Giờ mặc định khi chỉ nói ngày ("mai đi chợ")
# DEFAULT_HOUR=9
# TZ_OFFSET_MIN=420
# DB_PATH=data/reminders.db

# Việc không nói giờ: 1 = tự xếp vào khung trống (cách việc khác ≥30 phút), 0 = để trong inbox
# AUTO_SCHEDULE=1

# ===== AI hiểu cách nói lạ (tuỳ chọn) =====
# Parser luật luôn chạy trước; AI chỉ được hỏi khi luật không tìm thấy giờ.
# Bỏ trống LLM_MODEL = tắt AI. Đã thử qwen2.5:3b qua Ollama: chậm 3–7s/câu, không chính xác hơn luật → không khuyên dùng.
# Dùng endpoint kiểu OpenAI nào cũng được:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=<model, vd gpt-4o-mini>
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<provider/model>
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=qwen2.5:7b  (không cần key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Chờ AI tối đa bao nhiêu giây trước khi dùng parser luật
# LLM_TIMEOUT_SEC=60
# Khung giờ AI được phép tự xếp việc
# WORK_START_HOUR=8
# WORK_END_HOUR=21

# ===== Bridge Zalo (tuỳ chọn, thư viện không chính thức, nên dùng nick phụ) =====
ZALO_ENABLED=0
# 1 = nhận cả "#note" người khác gửi cho mình
# ZALO_ACCEPT_FROM_OTHERS=0
# ZALO_CREDENTIALS_PATH=data/zalo-credentials.json
