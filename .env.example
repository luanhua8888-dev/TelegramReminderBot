# ===== Bắt buộc =====
# Lấy từ @BotFather trên Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# Chat id được phép dùng bot, cách nhau bởi dấu phẩy. Chạy bot, nhắn /id để lấy.
# Chat id đầu tiên sẽ nhận note từ Zalo.
ALLOWED_CHAT_IDS=

# ===== Nhắc việc =====
# REPEAT_EVERY_MIN=15
# MAX_REPEATS=6
# Giờ gửi tóm tắt việc trong ngày, -1 để tắt
# DIGEST_HOUR=7
# Giờ mặc định khi chỉ nói ngày ("mai đi chợ")
# DEFAULT_HOUR=9
# TZ_OFFSET_MIN=420
# DB_PATH=data/reminders.db

# ===== AI tự hiểu câu và tự xếp lịch (tuỳ chọn) =====
# Bỏ trống LLM_MODEL = dùng parser luật có sẵn (không tốn tiền).
# Dùng endpoint kiểu OpenAI nào cũng được:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=<model, vd gpt-4o-mini>
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<provider/model>
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=qwen2.5:7b  (không cần key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Khung giờ AI được phép tự xếp việc
# WORK_START_HOUR=8
# WORK_END_HOUR=21

# ===== Bridge Zalo (tuỳ chọn, thư viện không chính thức, nên dùng nick phụ) =====
ZALO_ENABLED=0
# 1 = nhận cả "#note" người khác gửi cho mình
# ZALO_ACCEPT_FROM_OTHERS=0
# ZALO_CREDENTIALS_PATH=data/zalo-credentials.json
